rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each player can only read and write their own data:
    // users/{uid} (score, purchases, equipped items, nickname) and
    // users/{uid}/solved/{doc}.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Global ranking: any signed-in player can read it; each player can only
    // write their own entry, with just a nickname, total points and a date.
    match /leaderboard/{uid} {
      allow read: if request.auth != null;
      allow delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'points', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 20
        && request.resource.data.points is int
        && request.resource.data.points >= 0;
    }
  }
}
